# Two different uses depending on how you're running this:
#
# 1. Local dev (npm run dev): copy to .env.local to point the Vite dev server at a
#    non-default backend. Defaults to http://localhost:8080 if unset.
#
# 2. Docker deployment (docker compose up -d --build): copy to .env. VITE_API_BASE_URL is
#    REQUIRED here (compose refuses to build without it) and must be the backend's real,
#    publicly-reachable URL, since it gets baked into the JS bundle at build time.
VITE_API_BASE_URL=http://localhost:8080

# Docker deployment only: host port nginx is published on (http://<host>:FRONTEND_PORT).
FRONTEND_PORT=80
